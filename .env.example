# ==========================================
# FormSaathi Environment Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM & AI Keys (Optional - FormSaathi operates fully in high-accuracy Demo / Heuristic mode if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Speech & Translation APIs (Optional - Web Speech API operates client-side out of the box)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Database Configuration (Optional - File-backed persistent DB operates automatically if omitted)
MONGODB_URI=mongodb://localhost:27017/formsaathi
